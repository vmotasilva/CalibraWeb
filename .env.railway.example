# Railway Environment Variables Configuration
# Copy these to your Railway service "Variables" tab

# ============================================
# REQUIRED - Django Core Settings
# ============================================

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-minimum-50-characters-long

# Set to False in production (default: False)
DEBUG=False

# Your Railway domain (comma-separated if multiple)
ALLOWED_HOSTS=calibraweb.up.railway.app,.railway.app

# HTTPS domains for CSRF protection (comma-separated)
CSRF_TRUSTED_ORIGINS=https://calibraweb.up.railway.app,https://*.railway.app

# ============================================
# DATABASE - PostgreSQL (Railway Plugin)
# ============================================
# Railway PostgreSQL plugin automatically provides these variables:
# PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE
# 
# Or you can set DATABASE_URL directly:
# DATABASE_URL=postgresql://user:password@host:port/database

# ============================================
# OPTIONAL - Superuser Auto-Creation
# ============================================
# If set, 'python manage.py ensure_superuser' will create this user automatically
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@calibraweb.com
DJANGO_SUPERUSER_PASSWORD=ChangeThisToAStrongPassword123!

# ============================================
# OPTIONAL - Celery/Redis (Background Tasks)
# ============================================
# Only needed if using Celery worker/beat services
# REDIS_URL=redis://default:password@host:port
# CELERY_BROKER_URL=redis://default:password@host:port/0
# CELERY_RESULT_BACKEND=redis://default:password@host:port/0

# ============================================
# OPTIONAL - Django Settings
# ============================================
# Timezone (default: UTC)
TIME_ZONE=America/Sao_Paulo

# Security Headers (default: 31536000 = 1 year)
# SECURE_HSTS_SECONDS=31536000

# ============================================
# OPTIONAL - Email Configuration
# ============================================
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@calibraweb.com

# ============================================
# Notes:
# ============================================
# 1. Railway automatically sets PORT variable - don't override it
# 2. Database credentials come from PostgreSQL plugin - don't set manually
# 3. Remove or leave empty any variables you don't need
# 4. Never commit actual secrets to git - use Railway Variables UI
