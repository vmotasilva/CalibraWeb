# CalibraWeb - Environment Configuration Example
# Copy this file to .env and fill in your values

# ==============================================================================
# DJANGO SETTINGS
# ==============================================================================

# REQUIRED: Secret key for Django (generate one if needed)
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here

# Debug mode (True only in development, False in production)
DEBUG=False

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,*.railway.app

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# PostgreSQL connection (Railway or other)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/calibraweb

# ==============================================================================
# EMAIL CONFIGURATION - Fase 5: Exports and Scheduled Reports
# ==============================================================================

# Email backend to use
# Options:
#   django.core.mail.backends.console.EmailBackend       (logs to console - development)
#   django.core.mail.backends.smtp.EmailBackend          (sends real emails - production)
#   sendgrid_backend.SendgridBackend                     (SendGrid service)
#   django_ses.SESBackend                                (AWS SES)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP Configuration (for Gmail or other SMTP providers)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Gmail: Use App Password, NOT your regular password!
# How to get App Password: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-16-chars

# Default from address for emails
DEFAULT_FROM_EMAIL=noreply@calibraweb.com

# Email recipients for Phase 5 scheduled reports
# Format: email1@domain.com,email2@domain.com
REPORT_EMAIL_TO=gestor@empresa.com,supervisor@empresa.com
ALERT_EMAIL_TO=supervisor@empresa.com

# ==============================================================================
# CELERY CONFIGURATION - Fase 5: Task Queue and Scheduled Tasks
# ==============================================================================

# Celery broker URL (Redis or RabbitMQ)
# Redis: redis://localhost:6379/0
# RabbitMQ: amqp://guest:guest@localhost:5672//
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery backend for storing task results
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Celery timezone for scheduled tasks
CELERY_TIMEZONE=America/Sao_Paulo

# ==============================================================================
# FLOWER CONFIGURATION - Fase 5: Task Monitoring Dashboard
# ==============================================================================

# Flower port (default: 5555)
FLOWER_PORT=5555

# Flower authentication
FLOWER_USERNAME=admin
FLOWER_PASSWORD=your-secure-password

# Flower logging level
FLOWER_LOG_LEVEL=info

# Flower database file
FLOWER_DB=flower.db

# Maximum tasks to keep in memory
FLOWER_MAX_TASKS=10000

# Email for failure alerts (optional)
FLOWER_ALERT_EMAIL=supervisor@empresa.com
FLOWER_EMAIL_ON_FAILURE=false

# ==============================================================================
# SECURITY SETTINGS
# ==============================================================================

# CSRF trusted origins (for forms on different domains)
CSRF_TRUSTED_ORIGINS=https://*.railway.app,https://yourdomain.com

# SSL/HTTPS settings
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ==============================================================================
# AWS S3 CONFIGURATION (Optional - for static files in production)
# ==============================================================================

# AWS credentials
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=us-east-1

# ==============================================================================
# SENDGRID CONFIGURATION (Optional - if using SendGrid for emails)
# ==============================================================================

# SENDGRID_API_KEY=your-sendgrid-api-key

# ==============================================================================
# AWS SES CONFIGURATION (Optional - if using AWS SES for emails)
# ==============================================================================

# AWS_SES_REGION_NAME=us-east-1
# AWS_SES_REGION_ENDPOINT=email.us-east-1.amazonaws.com
