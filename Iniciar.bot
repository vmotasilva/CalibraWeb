@echo off
cd /d %~dp0
echo --- INICIANDO CALIBRA QMS ---
echo.

REM Garantir settings locais ao rodar no Windows
set DJANGO_SETTINGS_MODULE=config.settings_local

IF NOT EXIST "venv" (
    echo [AVISO] Ambiente virtual nao encontrado. Criando agora...
    python -m venv venv
    call .\venv\Scripts\activate
    echo [INFO] Instalando dependencias...
    pip install -r requirements.txt
) ELSE (
    call .\venv\Scripts\activate
)

echo.
echo [SUCESSO] Ambiente ativado. Iniciando servidor...
set PORT=8000

REM Se a porta 8000 já estiver em uso, usar 8001
netstat -ano | findstr ":8000" | findstr "LISTENING" >nul
IF %ERRORLEVEL% EQU 0 (
    set PORT=8001
)

echo Acesse em: http://127.0.0.1:%PORT%/
echo.
python manage.py runserver %PORT%
pause