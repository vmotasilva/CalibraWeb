# Development Local Configuration
# USE THIS FOR LOCAL DEVELOPMENT ONLY

# Django Settings
DEBUG=True
SECRET_KEY=dev-key-change-in-production-qwerty-uiop-1234567890
ALLOWED_HOSTS=localhost,127.0.0.1,*.local

# Database (SQLite for local development)
DATABASE_URL=sqlite:///db.sqlite3

# Redis (use local mock server)
REDIS_URL=redis://127.0.0.1:6379/0

# Celery (local setup)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Cache Configuration
CACHE_BACKEND=django_redis.cache.RedisCache

# Email (development - console backend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Security (local development)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Logging (development)
LOGGING_LEVEL=DEBUG

# AWS/Cloud Services (optional for local)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=

# Features (local development)
USE_S3=False
STATIC_URL=/static/
MEDIA_URL=/media/
