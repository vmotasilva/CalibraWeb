{
  "version": 2,
  "ignoreCommand": "bash scripts/vercel_ignore_build.sh",
  "builds": [
    {
      "src": "config/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/run-tasks/",
      "schedule": "0 0 * * *"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "config/wsgi.py"
    }
  ]
}
